# =============================================================================
# CHAPA TU VENTA - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# =============================================================================
# 
# Este archivo contiene todas las variables de entorno necesarias para el proyecto.
# Para configurar el proyecto localmente:
#   1. Copia este archivo a .env
#   2. Reemplaza los valores con tus credenciales reales
#
# IMPORTANTE: El archivo .env NO debe subirse a git (está en .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# CLERK AUTHENTICATION
# -----------------------------------------------------------------------------
# Clerk Publishable Key para autenticación de usuarios
# Obtén tu key en: https://dashboard.clerk.com
# Formato: pk_test_XXXXXX (desarrollo) o pk_live_XXXXXX (producción)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# -----------------------------------------------------------------------------
# BACKEND API
# -----------------------------------------------------------------------------
# URL del backend API de Chapa Tu Venta
# Desarrollo: https://api-dev.niukinshop.com/api
# Producción: https://api.niukinshop.com/api
EXPO_PUBLIC_API_URL=YOUR_API_URL

# -----------------------------------------------------------------------------
# SUPABASE
# -----------------------------------------------------------------------------
# Supabase URL - URL base de tu proyecto Supabase
# Formato: https://YOUR_PROJECT_ID.supabase.co/rest/v1
EXPO_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL

# Supabase API Key (service_role key)
# ADVERTENCIA: Esta es una key sensible con permisos completos
# Obtén tu key en: Supabase Dashboard > Settings > API
EXPO_PUBLIC_SUPABASE_API_KEY=YOUR_SUPABASE_API_KEY

# Supabase Auth Token (JWT token para autenticación)
# Normalmente es el mismo valor que SUPABASE_API_KEY
EXPO_PUBLIC_SUPABASE_AUTH_TOKEN=YOUR_SUPABASE_AUTH_TOKEN

# -----------------------------------------------------------------------------
# NODE ENVIRONMENT
# -----------------------------------------------------------------------------
# Entorno de ejecución (development, production)
NODE_ENV=production

# =============================================================================
# NOTAS IMPORTANTES
# =============================================================================
#
# 1. PREFIJO EXPO_PUBLIC_:
#    - Todas las variables que necesites en el código React Native deben tener
#      el prefijo EXPO_PUBLIC_ para que Expo las exponga al cliente
#    - Ejemplo: process.env.EXPO_PUBLIC_API_URL
#
# 2. SEGURIDAD:
#    - NUNCA subas el archivo .env a git
#    - Para builds con EAS, las variables se configuran en eas.json
#    - Considera usar EAS Secrets para mayor seguridad en producción
#
# 3. DESARROLLO LOCAL vs EAS BUILD:
#    - Desarrollo local: Lee variables de archivo .env
#    - EAS Build: Lee variables de eas.json (profiles preview/production)
#
# 4. GENERAR APK:
#    - Preview/Testing: eas build --profile preview --platform android
#    - Production: eas build --profile production --platform android
#
# =============================================================================
