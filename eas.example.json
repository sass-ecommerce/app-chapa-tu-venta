{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_YOUR_CLERK_PUBLISHABLE_KEY_HERE",
        "EXPO_PUBLIC_API_URL": "https://api-dev.niukinshop.com/api",
        "EXPO_PUBLIC_SUPABASE_URL": "https://YOUR_PROJECT.supabase.co/rest/v1",
        "EXPO_PUBLIC_SUPABASE_API_KEY": "YOUR_SUPABASE_API_KEY_HERE",
        "EXPO_PUBLIC_SUPABASE_AUTH_TOKEN": "YOUR_SUPABASE_AUTH_TOKEN_HERE"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_live_YOUR_PRODUCTION_CLERK_KEY_HERE",
        "EXPO_PUBLIC_API_URL": "https://api.niukinshop.com/api",
        "EXPO_PUBLIC_SUPABASE_URL": "https://YOUR_PROJECT.supabase.co/rest/v1",
        "EXPO_PUBLIC_SUPABASE_API_KEY": "YOUR_PRODUCTION_SUPABASE_API_KEY_HERE",
        "EXPO_PUBLIC_SUPABASE_AUTH_TOKEN": "YOUR_PRODUCTION_SUPABASE_AUTH_TOKEN_HERE"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
